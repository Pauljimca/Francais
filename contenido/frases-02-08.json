      "id": "m6-07",
      "fr": "Le soir, je joue de la guitare.",
      "es": "En la noche, toco la guitarra."
     },
     {
      "id": "m6-08",
      "fr": "Je me couche vers dix heures.",
      "es": "Me acuesto hacia las diez."
