      "id": "m7-10",
      "fr": "L'hôtel a ouvert l'année dernière.",
      "es": "El hotel abrió el año pasado."
     },
     {
      "id": "m7-11",
      "fr": "Le festival a eu beaucoup de succès.",
      "es": "El festival tuvo mucho éxito."
     },
     {
      "id": "m7-12",
      "fr": "Les vols sont plus chers cette année.",
      "es": "Los vuelos están más caros este año."
     }
