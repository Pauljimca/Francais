 "3": {
  "title": "En cuisine",
  "subtitle": "Ingredientes, cantidades, recetas y el restaurante",
  "anchor": "J'adore cuisiner. Le plat typique de l'île, c'est le rondón. Il y a du poisson, du lait de coco, du manioc et des bananes plantains. D'abord, je coupe le poisson. Ensuite, j'ajoute le lait de coco. Je fais cuire vingt minutes. C'est délicieux !",
  "blocks": [
   {
    "title": "A. En el restaurante",
    "phrases": [
     {
      "id": "m3-01",
      "fr": "Une table pour deux, s'il vous plaît.",
      "es": "Una mesa para dos, por favor."
     },
     {
      "id": "m3-02",
      "fr": "La carte, s'il vous plaît.",
      "es": "La carta, por favor."
     },
     {
      "id": "m3-03",
      "fr": "Qu'est-ce que vous recommandez ?",
      "es": "¿Qué recomienda?",
      "tu": {
       "fr": "Qu'est-ce que tu recommandes ?",
       "es": "¿Qué recomiendas?"
      }
     },
     {
      "id": "m3-04",
      "fr": "Je voudrais le poisson du jour.",
      "es": "Quisiera el pescado del día."
     },
     {
      "id": "m3-05",
      "fr": "Pour moi, un rondón.",
      "es": "Para mí, un rondón."
     },
     {
      "id": "m3-06",
      "fr": "L'addition, s'il vous plaît.",
      "es": "La cuenta, por favor."
     },
     {
      "id": "m3-07",
      "fr": "C'était délicieux !",
      "es": "¡Estuvo delicioso!"
     }
    ]
   },
   {
    "title": "B. Ingredientes",
    "phrases": [
     {
      "id": "m3-08",
      "fr": "Il y a du poisson et du riz.",
      "es": "Hay pescado y arroz.",
      "note": "du = de + le (masculino)"
     },
     {
      "id": "m3-09",
      "fr": "Je mets de la noix de coco.",
      "es": "Pongo coco.",
      "note": "de la (femenino)"
     },
     {
      "id": "m3-10",
      "fr": "J'ajoute de l'ail et de l'oignon.",
      "es": "Agrego ajo y cebolla.",
      "note": "de l' ante vocal"
     },
     {
      "id": "m3-11",
      "fr": "Je prends des bananes plantains.",
      "es": "Llevo plátanos.",
      "note": "des (plural)"
     },
     {
      "id": "m3-12",
      "fr": "Je ne mange pas de viande.",
      "es": "No como carne.",
      "note": "Negación: pas de"
     },
     {
      "id": "m3-13",
      "fr": "Il n'y a plus de sel.",
      "es": "Ya no hay sal.",
      "note": "ne… plus = ya no"
     }
    ]
   },
   {
    "title": "C. Cantidades",
    "phrases": [
     {
      "id": "m3-14",
      "fr": "Un kilo de poisson, s'il vous plaît.",
      "es": "Un kilo de pescado, por favor.",
      "note": "Después de una cantidad: de"
     },
     {
      "id": "m3-15",
      "fr": "Un litre de lait de coco.",
      "es": "Un litro de leche de coco."
     },
     {
      "id": "m3-16",
