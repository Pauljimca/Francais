      "fr": "Une cuillère de sucre.",
      "es": "Una cucharada de azúcar."
     },
     {
      "id": "m3-18",
      "fr": "Un peu de sel.",
      "es": "Un poco de sal."
     },
     {
      "id": "m3-19",
      "fr": "Beaucoup de citron.",
      "es": "Mucho limón."
     },
     {
      "id": "m3-20",
      "fr": "Combien de bananes ?",
      "es": "¿Cuántos plátanos?"
     }
    ]
   },
   {
    "title": "D. La receta",
    "phrases": [
     {
      "id": "m3-21",
      "fr": "Coupez le poisson.",
      "es": "Corte el pescado.",
      "note": "Imperativo",
      "tu": {
       "fr": "Coupe le poisson.",
       "es": "Corta el pescado."
      }
     },
     {
      "id": "m3-22",
      "fr": "Ajoutez le lait de coco.",
      "es": "Agregue la leche de coco.",
      "tu": {
