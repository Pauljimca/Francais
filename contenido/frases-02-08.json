       "es": "Cocina veinte minutos."
      }
     },
     {
      "id": "m3-24",
      "fr": "Mélangez bien.",
      "es": "Mezcle bien.",
      "tu": {
       "fr": "Mélange bien.",
       "es": "Mezcla bien."
      }
     },
     {
      "id": "m3-25",
      "fr": "Servez chaud.",
      "es": "Sirva caliente.",
      "tu": {
       "fr": "Sers chaud.",
       "es": "Sirve caliente."
      }
     }
    ]
   },
   {
    "title": "E. Sabores",
    "phrases": [
     {
      "id": "m3-26",
      "fr": "J'ai faim !",
      "es": "¡Tengo hambre!",
      "note": "Con avoir: j'ai faim, j'ai soif"
     },
     {
      "id": "m3-27",
      "fr": "J'ai soif.",
      "es": "Tengo sed."
